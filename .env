# Immich Server Configuration
IMMICH_SERVER="user@hostname_or_ip"

# Backup Server Configuration
BACKUP_SERVER="user@hostname_or_ip"
BACKUP_SERVER_PORT="22"

# Directory Paths
IMMICH_BACKUP_DIR="/path/to/backup/generated_on_immich_server"
BACKUP_DEST_BASE="/path/to/backup/location/on/backup_server"

# Optional: Auto-cleanup (set to "true" to automatically remove backup from Immich server after transfer)
AUTO_CLEANUP="true"
